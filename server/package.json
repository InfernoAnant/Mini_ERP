{
  "name": "mini-erp-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "prisma": "6.19.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
